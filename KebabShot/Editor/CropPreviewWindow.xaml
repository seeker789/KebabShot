<Window x:Class="KebabShot.Editor.CropPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="KebabShot - Preview"
        Background="#1E1E1E"
        WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Preview Image -->
        <Border Background="#333" CornerRadius="6" Padding="6">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
        </Border>

        <!-- Button Bar -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Button x:Name="CopyBtn"
            Content="Copy"
            Width="100"
            Height="35"
            Margin="0,0,10,0"
            Click="CopyBtn_Click"/>

            <Button x:Name="SaveBtn"
            Content="Save"
            Width="100"
            Height="35"
            Margin="0,0,10,0"
            Click="SaveBtn_Click"/>

            <Button x:Name="UploadBtn"
            Content="Upload"
            Width="100"
            Height="35"
            Background="#007ACC"
            Foreground="White"
            Click="UploadBtn_Click"/>
        </StackPanel>


    </Grid>
</Window>
